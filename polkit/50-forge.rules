// /etc/polkit-1/rules.d/50-forge.rules
// Grants testuser and forge service account the right to start/stop/restart
// forge-* and ai-mode-comfyui units without a password prompt.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        if (unit.match(/^forge-.*\.service$/) ||
            unit === "ai-mode-comfyui.service")
        {
            if (subject.user === "testuser" || subject.user === "forge") {
                return polkit.Result.YES;
            }
        }
    }
});
