# /etc/systemd/system/forge-tts-custom.service
# Resident tts-server for the customvoice model (the hot path: aiden/ryan and
# any customvoice synthesis). Kept GPU-resident so forge-tts on 8082 can proxy
# to it with no per-call model reload. The Go service falls back to the CLI
# backend automatically if this instance is down.
#
# base already runs resident as forge-tts-base.service (port 8093, this
# unit's own comment previously suggested cloning to 8092/8093 as if neither
# existed yet). voicedesign has no resident unit deployed — clone this one at
# port 8092 if that changes. Either way, don't hand-set FORGE_TTS_SERVER_* via
# /opt/forge/tts_voices/.internal_token_env any more — the daemon now writes
# /var/lib/forge/tts/forge-tts.env from the tts.engines setting (Settings ->
# Voice & Speech) and restarts forge-tts.service itself when it changes.
[Unit]
Description=Forge — TTS resident customvoice (tts-server, port 8091)
After=network.target

[Service]
Type=simple
User=testuser
Group=testuser
WorkingDirectory=/opt/forge
ExecStart=/opt/forge/qwentts.cpp/build/tts-server \
  --model /opt/forge/qwentts.cpp/models/qwen-talker-1.7b-customvoice-Q8_0.gguf \
  --codec /opt/forge/qwentts.cpp/models/qwen-tokenizer-12hz-Q8_0.gguf \
  --host 127.0.0.1 --port 8091 --alias customvoice
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forge-tts-custom

[Install]
WantedBy=multi-user.target
