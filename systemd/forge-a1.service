# /etc/systemd/system/forge-a1.service
# A1 (formerly "primary") inference slot — always port 8080.
# Model loaded depends on which mode the engine activated last.
# Engine writes /etc/sysconfig/forge-a1-{env,args} before starting this unit.
[Unit]
Description=Forge — A1 Inference (port 8080)
After=network.target

[Service]
Type=simple
User=testuser
Group=testuser
# The launcher is the generic shim (ADR-0026): `forge slot-exec a1` reads this slot's launch from the database, so there is no EnvironmentFile.
ExecStart=/usr/local/lib/forge/start-a1.sh
Restart=on-failure
RestartSec=10
# Exit codes slot-exec uses for failures a retry cannot fix (66 no row, 73 bad executable, 75 disarmed, 78 malformed row); 69 (database unreadable) is retried.
RestartPreventExitStatus=66 73 75 78
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forge-a1
TimeoutStopSec=300
ReadWritePaths=/var/lib/forge /var/lib/forge/switch.log
