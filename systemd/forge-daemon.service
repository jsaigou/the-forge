# /etc/systemd/system/forge-daemon.service
# The Forge v0.6 single-binary daemon: dashboard (:5000) + a0 router (:8085) + MCP (:8095).
[Unit]
Description=The Forge — v0.6 daemon (dashboard + a0 router + MCP)
After=network.target

[Service]
Type=simple
User=testuser
Group=testuser
ExecStart=/opt/forge/forge
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forge-daemon
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
