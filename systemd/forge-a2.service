# /etc/systemd/system/forge-a2.service
# A2 (formerly "secondary") inference slot — always port 8081.
# Only started in dual-model modes (e.g. coding).
[Unit]
Description=Forge — A2 Inference (port 8081)
After=network.target

[Service]
Type=simple
User=testuser
Group=testuser
# The launcher is the generic shim (ADR-0026): `forge slot-exec a2` reads this slot's launch from the database, so there is no EnvironmentFile.
ExecStart=/usr/local/lib/forge/start-a2.sh
Restart=on-failure
RestartSec=10
# Exit codes slot-exec uses for failures a retry cannot fix (66 no row, 73 bad executable, 75 disarmed, 78 malformed row); 69 (database unreadable) is retried.
RestartPreventExitStatus=66 73 75 78
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forge-a2
TimeoutStopSec=300
ReadWritePaths=/var/lib/forge
