# /etc/systemd/system/forge-tts.service
# Speech front door (port 8082): the OpenAI-compatible speech + voices contract and the voice registry. It runs no engine itself: for every request it
# asks the Forge daemon where an engine is (docs/speech-routing-plan.md), so engines live in the specialist pool (Settings -> Voice & Speech).
[Unit]
Description=Forge — TTS front door (speech engines resolved per request by the Forge daemon, port 8082)
After=network.target

[Service]
Type=simple
User=testuser
Group=testuser
WorkingDirectory=/opt/forge
# Pure-Go service. Build from ai-mode:
#   cd go && go build -o /opt/forge/forge-tts ./cmd/forge-tts
# It REFUSES TO START without FORGE_TTS_DAEMON_KEY (a speech-scoped key:
#   forge mint-key -kind forge -role operator -scope speech -bind-ip 127.0.0.1 -ttl 8760h -name forge-tts-speech).
# Put the key (and FORGE_TTS_DAEMON_KEY_EXPIRES, FORGE_TTS_INTERNAL_TOKEN) in the env file below, not in this unit. FORGE_TTS_DEFAULT_VOICE names the voice
# for requests that name none; without it such a request is refused.
ExecStart=/opt/forge/forge-tts
Environment=FORGE_TTS_LISTEN=127.0.0.1:8082
Environment=FORGE_TTS_REGISTRY=/opt/forge/tts_voices
EnvironmentFile=-/opt/forge/tts_voices/.internal_token_env
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forge-tts
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
