[Unit]
Description=The Forge — STT Server (Qwen3-ASR-0.6B, port 8084)
After=network.target

[Service]
Type=simple
User=testuser
Group=testuser
ExecStart=/opt/forge/qwen3-asr-src/build/qwen3-asr-server \
    -m /opt/forge/models/qwen3-asr/qwen3-asr-0.6b-q8_0.gguf \
    --host 127.0.0.1 \
    --port 8084 \
    --max-upload-mb 512 \
    --convert \
    -t 4
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forge-stt
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
