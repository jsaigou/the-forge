# /etc/systemd/system/forge-a3.service
# a3 inference slot — always port 8087.
# Only started when a model is explicitly loaded into this slot.
[Unit]
Description=Forge — A3 Inference (port 8087)
After=network.target

[Service]
Type=simple
User=testuser
Group=testuser
EnvironmentFile=/etc/sysconfig/forge-a3-env
ExecStart=/usr/local/lib/forge/start-a3.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forge-a3
TimeoutStopSec=300
ReadWritePaths=/var/lib/forge
