# /etc/systemd/system/forge-a3.service
# a3 inference slot — always port 8087.
# Only started when a model is explicitly loaded into this slot.
[Unit]
Description=Forge — A3 Inference (port 8087)
After=network.target

[Service]
Type=simple
User=testuser
Group=testuser
# The launcher is the generic shim (ADR-0026): `forge slot-exec a3` reads this slot's launch from the database, so there is no EnvironmentFile.
ExecStart=/usr/local/lib/forge/start-a3.sh
Restart=on-failure
RestartSec=10
# Exit codes slot-exec uses for failures a retry cannot fix (66 no row, 73 bad executable, 75 disarmed, 78 malformed row); 69 (database unreadable) is retried.
RestartPreventExitStatus=66 73 75 78
StandardOutput=journal
StandardError=journal
SyslogIdentifier=forge-a3
TimeoutStopSec=300
ReadWritePaths=/var/lib/forge
